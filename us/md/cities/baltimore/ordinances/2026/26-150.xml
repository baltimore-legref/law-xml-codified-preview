  <heading type="short">Measurement of Building Height – Gambrel Roofs</heading>
  <heading type="long">An Ordinance Concerning Measurement of Building Height – Gambrel Roofs</heading>
  <meta>
    <stub/>
    <introduced>2026-02-23</introduced>
    <effective>2026-11-22</effective>

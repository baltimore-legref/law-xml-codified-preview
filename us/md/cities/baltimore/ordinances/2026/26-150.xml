  <section>
    <prefix>Section</prefix>
    <num>1</num>
    <codify:replace path="32|§15-301|(a)|(2)|(ii)" codified:doc="City of Baltimore, Md., Code" codified:path="32|§15-301|(a)|(2)|(ii)">
      <para>
        <num>(ii)</num>
        <text>to the following, as applicable:</text>
        <para>
          <num>(A)</num>
          <text>in the case of a flat roof, to the highest point of the roof that adjoins the street wall;</text>
        </para>
        <para>
          <num>(B)</num>
          <text>in the case of a pitched roof, to the mean height level of the roof as measured between the top of the highest wall plate and the highest point of the roof; or</text>
        </para>
        <para>
          <num>(C)</num>
          <text>in the case of a gambrel roof, to the mean height of the roof as measured between the lowest point of the highest sloped portion of the roof and the peak of the highest sloped portion of the roof.</text>
        </para>
      </para>
    </codify:replace>
  </section>
